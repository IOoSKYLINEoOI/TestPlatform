{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TestPlatformContextPostgreSQL": "Host=localhost;Port=5432;Database=testPlatformDb;Username=postgres;Password=123456789"
  },
  "ImageStorage": {
    "RootPath": "wwwroot/images",
    "TempFolder": "temp",
    "PermanentFolder": "permanent",
    "MaxWidth": 1200,
    "MaxHeight": 1200
  },
  "Keycloak": {
    "AuthorizationUrl" : "http://localhost:8080/realms/test-platform/protocol/openid-connect/auth",
    "TokenUrl": "http://localhost:8080/realms/test-platform/protocol/openid-connect/token"
  },
  "Authentication": {
    "MetadataAddress": "http://keycloak:8080/realms/test-platform/.well-known/openid-configuration",
    "ValidIssuer": "http://localhost:8080/realms/test-platform",
    "Audience": "account"
  }
}