# Copy this file to /opt/testplatform/.env on the production server.
# Replace every change-... value with a unique secret. Do not commit the server .env file.

APP_VERSION=v1.5.0
API_IMAGE=ghcr.io/iooskylineooi/testplatform-api
ADMIN_IMAGE=ghcr.io/iooskylineooi/testplatform-admin

APP_DB_USER=testplatform
APP_DB_PASSWORD=change-app-db-password

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-keycloak-db-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-keycloak-admin-password
KEYCLOAK_ADMIN_CLIENT_SECRET=change-keycloak-admin-client-secret
KEYCLOAK_REALM=test-platform
KEYCLOAK_API_AUDIENCE=test-platform-api
KEYCLOAK_ADMIN_CLIENT_ID=test-platform-admin
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=https://auth.henkel-academy.ru

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-minio-root-password
MINIO_BUCKET_NAME=testplatform-images
MINIO_PUBLIC_URL=https://files.henkel-academy.ru

SEQ_ADMIN_PASSWORD=change-seq-admin-password
APP_PUBLIC_URL=https://app.henkel-academy.ru
