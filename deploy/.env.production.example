# Copy this file to .env on the production server. Never commit the resulting file.

# Immutable container images published by CI or your container registry.
API_IMAGE=ghcr.io/your-organization/testplatform-api
ADMIN_IMAGE=ghcr.io/your-organization/testplatform-admin
APP_VERSION=replace-with-a-release-tag

# Public HTTPS URLs. The host names must match deploy/nginx/testplatform.conf.template.
APP_PUBLIC_URL=https://app.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com
MINIO_PUBLIC_URL=https://files.example.com

APP_DB_USER=testplatform
APP_DB_PASSWORD=replace-with-a-long-random-password

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-a-long-random-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_BUCKET_NAME=testplatform-images

SEQ_ADMIN_PASSWORD=replace-with-a-long-random-password
