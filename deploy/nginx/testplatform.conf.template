# Certificates are expected at /etc/letsencrypt/live/<domain>/ after certbot runs.

server {
    listen 80;
    listen [::]:80;
    server_name henkel-academy.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://app.henkel-academy.ru$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name app.henkel-academy.ru api.henkel-academy.ru auth.henkel-academy.ru files.henkel-academy.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name henkel-academy.ru henkel-academy.online;

    ssl_certificate /etc/letsencrypt/live/henkel-academy.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/henkel-academy.ru/privkey.pem;
    return 301 https://app.henkel-academy.ru$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name app.henkel-academy.ru;

    ssl_certificate /etc/letsencrypt/live/henkel-academy.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/henkel-academy.ru/privkey.pem;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:5176;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.henkel-academy.ru;

    ssl_certificate /etc/letsencrypt/live/henkel-academy.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/henkel-academy.ru/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5062;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name auth.henkel-academy.ru;

    ssl_certificate /etc/letsencrypt/live/henkel-academy.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/henkel-academy.ru/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name files.henkel-academy.ru;

    ssl_certificate /etc/letsencrypt/live/henkel-academy.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/henkel-academy.ru/privkey.pem;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:9100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
    }
}
